def test_r2(env):
    print("\n--- R2 bucket read/write test ---")
    print("Checking .env / environment for R2 credentials …")

    r2_bucket = prompt("R2 bucket name", env.get("R2_BUCKET"), required=True)
    r2_account = prompt("R2 account ID", env.get("R2_ACCOUNT_ID"), required=True)
    r2_key_id = prompt("R2 access key ID", env.get("R2_ACCESS_KEY_ID"), required=True)
    r2_secret = prompt("R2 secret access key", env.get("R2_SECRET_ACCESS_KEY"), secret=True, required=True)
    r2_public_domain = prompt("R2 public domain (optional, skip for presigned URLs)", env.get("R2_PUBLIC_DOMAIN"))

    test_file = f"/tmp/backup-test-{os.getpid()}.txt"
    Path(test_file).write_text(f"R2 connectivity test from backup CLI\nGenerated at {datetime.utcnow().isoformat()} UTC\n")
    object_key = f"tests/backup-test-{os.getpid()}.txt"

    child_env = os.environ.copy()
    child_env.update({
        "R2_BUCKET": r2_bucket,
        "R2_ACCOUNT_ID": r2_account,
        "R2_ACCESS_KEY_ID": r2_key_id,
        "R2_SECRET_ACCESS_KEY": r2_secret,
        "R2_PUBLIC_DOMAIN": r2_public_domain,
        "R2_URL_TTL_SECONDS": "3600",
    })

    script = ROOT / "lib" / "r2-upload.sh"
    try:
        url = subprocess.check_output(
            ["bash", str(script), test_file, object_key],
            env=child_env,
            text=True,
        ).strip()
        print(f"\n  ✔ Write succeeded")
        print(f"  Bucket: {r2_bucket}")
        print(f"  Key:    {object_key}")
        print(f"  URL:    {url}")

        # Try to read the object back using curl.
        read_check = subprocess.run(
            ["curl", "-fsSL", "-o", "/dev/null", "-w", "%{http_code}", url],
            capture_output=True,
            text=True,
        )
        if read_check.returncode == 0 and read_check.stdout.strip() == "200":
            print("  ✔ Read succeeded (HTTP 200)")
        else:
            print(f"  ✖ Read check failed: HTTP {read_check.stdout.strip()}")
    except subprocess.CalledProcessError as e:
        raise RuntimeError(f"R2 upload failed: {e.stderr or e.output or 'unknown error'}")
    finally:
        Path(test_file).unlink(missing_ok=True)

    # Save non-secret defaults back to .env for next time.
    save_env = {
        "R2_BUCKET": r2_bucket,
        "R2_ACCOUNT_ID": r2_account,
        "R2_ACCESS_KEY_ID": r2_key_id,
        "R2_PUBLIC_DOMAIN": r2_public_domain,
    }
    if confirm("Save R2 secret access key to .env?", default=False):
        save_env["R2_SECRET_ACCESS_KEY"] = r2_secret
    save_dotenv(ENV_FILE, save_env)
    print(f"  ✔ Saved settings to {ENV_FILE}")


def main():
    parser = argparse.ArgumentParser(description="Create downloadable backups of sites and store them in R2")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("runcloud", help="back up one RunCloud app to R2")
    subparsers.add_parser("test", help="test R2 bucket read/write credentials")
    args = parser.parse_args()

    check_tools()

    if not ENV_FILE.exists() and ENV_EXAMPLE.exists():
        if confirm(".env not found. Create it from .env.example?", default=True):
            ENV_FILE.write_text(ENV_EXAMPLE.read_text())
            print(f"  ✔ Created {ENV_FILE}")

    env = load_dotenv(ENV_FILE)

    if args.command == "runcloud":
        backup_runcloud(env)
    elif args.command == "test":
        test_r2(env)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\n  Aborted.")
        sys.exit(1)
    except RuntimeError as e:
        print(f"\n✖ {e}")
        sys.exit(1)
