# source-servers.csv  —  inventory of source servers for `migrate domain.tld`
#
# Columns:
#   name,type,ssh_host,ssh_port,ssh_user,ssh_key,api_token,api_url,server_id,web_directory,notes
#
#   type: runcloud | ploi | coolify | ssh
#   ssh_host: IP or hostname (without username; put username in ssh_user)
#   ssh_user: SSH username
#   ssh_key: path to private key
#   api_token / api_url / server_id: only needed for type=ploi
#   web_directory: only used for type=ploi (default /public)
#   notes: free text
#
name,type,ssh_host,ssh_port,ssh_user,ssh_key,api_token,api_url,server_id,web_directory,notes
