def main():
    parser = argparse.ArgumentParser(description="Migrate a WordPress site to Ploi")
    subparsers = parser.add_subparsers(dest="command")

    parser_migrate = subparsers.add_parser("domain", help="migrate a domain")
    parser_migrate.add_argument("domain", help="domain to migrate, e.g. example.com")
    parser_migrate.add_argument("--source-type", choices=["runcloud", "ploi", "coolify", "ssh"],
                        help="only probe source servers of this type")
    parser_migrate.add_argument("--target-server-id", help="target Ploi server ID")

    subparsers.add_parser("setup", help="interactively configure .env credentials")

    args = parser.parse_args()

    if args.command == "setup":
        if not ENV_FILE.exists() and ENV_EXAMPLE.exists():
            if confirm(".env not found. Create it from .env.example?", default=True):
                ENV_FILE.write_text(ENV_EXAMPLE.read_text())
                print(f"  ✔ Created {ENV_FILE}")
        env = load_dotenv(ENV_FILE)
        interactive_setup(env)
        return

    if args.command is None or args.command == "domain":
        domain = (getattr(args, "domain", None) or "").lower().strip()
        if not domain:
            parser.error("domain is required")
            sys.exit(1)

        print("=" * 60)
        print(f"  migrate {domain} → Ploi")
        print("=" * 60)

        check_tools()

        if not ENV_FILE.exists() and ENV_EXAMPLE.exists():
            if confirm(".env not found. Create it from .env.example?", default=True):
                ENV_FILE.write_text(ENV_EXAMPLE.read_text())
                print(f"  ✔ Created {ENV_FILE}")

        env = load_dotenv(ENV_FILE)
        servers_file = source_servers_file(env)

        if not servers_file.exists() and SOURCE_SERVERS_EXAMPLE.exists():
            if confirm("Source server inventory not found. Create it from source-servers.csv.example?", default=True):
                servers_file.parent.mkdir(parents=True, exist_ok=True)
                servers_file.write_text(SOURCE_SERVERS_EXAMPLE.read_text())
                print(f"  ✔ Created {servers_file}")
                print("  → Edit that file with your real source servers, then rerun.")
                sys.exit(0)

        servers = load_source_servers(servers_file)
        if not servers:
            print("\n! No source servers configured.")
            if not confirm("Add one now?", default=True):
                sys.exit(1)
            server = ask_new_source_server(env)
            servers = [server]

        print(f"\n--- Discovering where {domain} is hosted ---")
        matches = probe_all_sources(servers, domain, env=env, source_type=args.source_type)

        if not matches:
            print(f"\n! Could not find {domain} on any configured source server.")
            if not confirm("Add a new source server that hosts it?", default=True):
                sys.exit(1)
            server = ask_new_source_server(env)
            m = None
            if server.get("type") == "ploi":
                m = ploi_probe(server, domain, env)
            else:
                m = ssh_probe(server, domain)
            if not m:
                print(f"✖ Still could not find {domain} on {server.get('name')}")
                sys.exit(1)
            matches = [m]

        match = choose_match(matches, domain)
        source = match["server"]
        print(f"\n  → Source: {source.get('name')} ({source.get('type')}) — "
              f"{match.get('wp_path') or match.get('site_root')}")

        if not confirm(f"Migrate {domain} from this source?", default=True):
            print("  Aborted.")
            sys.exit(0)

        target_env = configure_target(env, target_server_id_arg=args.target_server_id)
        env.update(target_env)
        save_dotenv(ENV_FILE, env)
        print(f"\n  ✔ Saved target settings to {ENV_FILE}")

        run_backup(match, domain, env)
        zip_file = find_latest_zip(domain)
        if not zip_file:
            print(f"\n✖ Backup succeeded but no zip was found in ./downloads for {domain}")
            sys.exit(1)
        print(f"\n  ✔ Backup zip: {zip_file}")

        if not confirm("Restore this backup to the target Ploi server?", default=True):
            print(f"\n  Backup is ready: {zip_file}")
            print("  Restore later with:")
            print(f"    DOMAIN={shlex.quote(domain)} ./ploi-migrate.sh {shlex.quote(str(zip_file))}")
            return

        run_restore(domain, zip_file, target_env)

        print("\n" + "=" * 60)
        print("  ✔ Migration complete")
        print("=" * 60)
        print(f"  Site:   https://{domain}")
        print(f"  Backup: {zip_file}")
        print(f"  Status: config/status.tsv")
        if match["server"].get("type") == "coolify":
            uuid = match.get("coolify_service_uuid") or ""
            print()
            print("  NOTE: The Coolify source service was left untouched.")
            print("        After you visually verify the migrated site, remove it manually:")
            print(f"          SSH_HOST={match['server'].get('ssh_user', 'root')}@{match['server'].get('ssh_host')} \\")
            print(f"          COOLIFY_SERVICE_UUID={uuid or '<uuid>'} \\")
            print(f"          ./coolify-remove.sh")
        return

    parser.print_help()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\n  Aborted.")
        sys.exit(1)
    except RuntimeError as e:
        print(f"\n✖ {e}")
        sys.exit(1)
