# ── RunCloud backup  (runcloud-wp-backup.sh / batch-migrate.sh) ──────────────
# Path to the SSH private key authorized on the RunCloud server.
SSH_KEY=~/.ssh/id_ed25519
# SSH port of the RunCloud server.
SSH_PORT=22
# Path to the batch CSV used by batch-migrate.sh.
CLIENTS_CSV=clients.csv

# ── RunCloud backup safety / behavior ───────────────────────────────────────
# Minimum free bytes required on both local and remote disks before zipping.
RC_MIN_FREE_BYTES=2147483648
# Delete the remote DB dump after downloading it (yes/no).
RC_CLEANUP_DB_DUMP=yes
# Delete the remote temp zip after download (yes/no).
RC_CLEANUP_REMOTE_ZIP=yes
# Test the downloaded zip with unzip -t (yes/no).
RC_VERIFY_ZIP=yes

# ── Ploi source backup  (ploi-wp-backup.sh / ploi-to-ploi.sh) ───────────────
# Numeric ID of the source Ploi server.
PLOI_SOURCE_SERVER_ID=
# SSH host for the source Ploi server (privileged admin).
PLOI_SOURCE_SSH_HOST=
# SSH port for the source Ploi server.
PLOI_SOURCE_SSH_PORT=22
# Privileged SSH user for the source Ploi server (ploi or root).
PLOI_SOURCE_SSH_USER=ploi
# Private key authorized for the source admin user.
PLOI_SOURCE_SSH_KEY=~/.ssh/id_ed25519
# Web directory inside the source site root.
PLOI_SOURCE_WEB_DIRECTORY=/public

# ── Ploi API  (ploi-migrate.sh / ploi-wp-backup.sh) ─────────────────────────
# Generate a token at https://ploi.io/profile/api-keys
# (it needs read+write scopes for servers, sites and databases).
# One token is shared by both source and target Ploi servers.
PLOI_API_TOKEN=
# API base URL (almost never changed).
PLOI_API_URL=https://ploi.io/api
# Numeric ID of the target Ploi server.
PLOI_SERVER_ID=

# ── Ploi SSH/SFTP  (initial setup + per-site isolation) ─────────────────────
# IP or hostname of the target Ploi server.
PLOI_SSH_HOST=
# SSH port of the target Ploi server.
PLOI_SSH_PORT=22
# Privileged admin user (ploi or root).
PLOI_SSH_USER=ploi
# Private key authorized for the target admin user above.
PLOI_SSH_KEY=~/.ssh/id_ed25519

# ── Ploi migration behavior ─────────────────────────────────────────────────
# How to create system users: per-site or shared.
PLOI_SYSTEM_USER_STRATEGY=per-site
# Used only when STRATEGY=shared.
PLOI_SHARED_SYSTEM_USER=ploi
# Add PLOI_SSH_KEY's public key to every per-site system user (yes/no).
PLOI_ADD_SSH_KEY_TO_SITE_USER=yes
# Lock per-site system users to their home directory via chroot (yes/no).
PLOI_CHROOT_SITE_USER=yes
# Auto-generate database name + user + a strong password per site (yes/no).
PLOI_DB_AUTOGEN=yes
# PHP version to assign to created sites.
PLOI_PHP_VERSION=8.2
# SSL mode: auto, always, or never.
PLOI_SSL_MODE=auto
# Domain mode: same or custom.
PLOI_DOMAIN_MODE=same

# ── Cloudflare R2 credentials (backup command) ───────────────────────────────
# R2 bucket name for backups.
R2_BUCKET=
# Cloudflare account ID.
R2_ACCOUNT_ID=
# R2 S3-compatible access key ID.
R2_ACCESS_KEY_ID=
# R2 S3-compatible secret access key.
R2_SECRET_ACCESS_KEY=
# Optional custom public domain for R2 (requires bucket to be public).
R2_PUBLIC_DOMAIN=
# Presigned URL lifetime in seconds (default 30 days).
R2_URL_TTL_SECONDS=2592000

# ── Unified migration CLI (migrate) ─────────────────────────────────────────
# Inventory of source servers used by the migrate command.
SOURCE_SERVERS_CSV=config/source-servers.csv

# ── Cloudflare DNS check  (migrate) ─────────────────────────────────────────
# Cloudflare API token.
# Required permissions: Zone:Read, DNS:Edit.
# Add Email Send permission if you want backup to send emails.
CLOUDFLARE_API_TOKEN=
# Cloudflare API base URL.
CLOUDFLARE_API_URL=https://api.cloudflare.com/client/v4
# Cloudflare account ID (required for Email Service REST API).
CLOUDFLARE_ACCOUNT_ID=

# ── Backup notification email ────────────────────────────────────────────────
# From address for backup emails. Domain must be onboarded to Email Service.
EMAIL_FROM=
# Display name for backup emails.
EMAIL_FROM_NAME=RunCloud Backups
# Default client email (optional, used to pre-fill backup reports).
BACKUP_CLIENT_EMAIL=

# ── Runtime ─────────────────────────────────────────────────────────────────
# Set BATCH=1 to make every prompt accept its default (fully non-interactive).
BATCH=0
