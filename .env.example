# ============================================================================
# .env.example  —  copy to .env and fill in.
#
# Copy it:   cp .env.example .env
# Then edit .env with your real values. Real environment variables always win
# over .env, so `PLOI_API_TOKEN=xxx ./script` overrides the file too.
#
# Format:  KEY=VALUE        (one per line)
#   - lines starting with # are comments; blank lines are ignored
#   - quote values with spaces:  KEY="some value"
#   - optional `export ` prefix is allowed:  export KEY=value
#   - use ~/ or absolute paths for files (e.g. ~/.ssh/id_ed25519)
#   - do NOT put inline comments after a value, and $VAR is NOT expanded
# ============================================================================

# ── RunCloud backup  (runcloud-wp-backup.sh / batch-migrate.sh) ──────────────
# Private key used to SSH into your RunCloud servers (the PRIVATE key, not .pub).
SSH_KEY=~/.ssh/id_ed25519
# SSH port shared by all RunCloud servers.
SSH_PORT=22

# ── Ploi API  (ploi-migrate.sh) ──────────────────────────────────────────────
# Generate a token at https://ploi.io/profile/api-keys
# (it needs read+write scopes for servers, sites and databases).
PLOI_API_TOKEN=
# API base URL (almost never changed).
PLOI_API_URL=https://ploi.io/api
# Numeric ID of the target Ploi server. Leave blank to choose interactively
# (the script lists your servers via the API and lets you pick).
PLOI_SERVER_ID=

# ── Ploi SSH/SFTP  (used to upload + extract the WordPress files) ────────────
# These describe the POLOI server (NOT RunCloud). Needed because the Ploi API
# has no file-upload endpoint, so files are transferred over SSH/SFTP.
PLOI_SSH_HOST=                 # e.g. 203.0.113.10
PLOI_SSH_PORT=22
PLOI_SSH_USER=ploi             # Ploi's default sudo user; use "root" if needed
PLOI_SSH_KEY=~/.ssh/id_ed25519 # private key authorized on the Ploi server

# ── Ploi migration behavior ─────────────────────────────────────────────────
# How to create system users: "per-site" (isolated, recommended) or "shared".
PLOI_SYSTEM_USER_STRATEGY=per-site
# Used only when STRATEGY=shared. Ploi's default user is "ploi".
PLOI_SHARED_SYSTEM_USER=ploi
# Auto-generate database name + user + a strong password per site (yes/no).
PLOI_DB_AUTOGEN=yes
# PHP version to assign to created sites (must be installed on the server).
PLOI_PHP_VERSION=8.2
# SSL / Let's Encrypt:
#   auto   = request only if the domain's DNS already resolves to Ploi (default)
#   always = always request
#   never  = skip SSL
PLOI_SSL_MODE=auto
# Domain handling: "same" = no URL change; "custom" = run wp search-replace
# (see the optional new_domain column in clients.csv).
PLOI_DOMAIN_MODE=same
# Project type + web directory for created sites.
PLOI_PROJECT_TYPE=wordpress
PLOI_WEB_DIRECTORY=/public
# Database host on the Ploi server.
PLOI_DB_HOST=127.0.0.1
# Trigger a deploy at the end to finalize the nginx config (yes/no).
PLOI_RUN_DEPLOY=yes
# Install wp-cli on the server if it's missing before running wp commands (yes/no).
PLOI_INSTALL_WP_CLI=yes

# ── Batch / CSV  (batch-migrate*.sh) ────────────────────────────────────────
# Folder where backup zips live (relative to the project root, or absolute).
DOWNLOADS_DIR=downloads
# CSV with one site per line: user,ip[,domain[,new_domain]]
CLIENTS_CSV=clients.csv

# ── Runtime ─────────────────────────────────────────────────────────────────
# Set BATCH=1 to make every prompt accept its default (fully non-interactive).
# BATCH=1
